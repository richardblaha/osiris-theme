    "settings.headerForeground": "#1f2328",
    "settings.modifiedItemIndicator": "#e01a76",
    "settings.focusedRowBackground": "#0969da0d",
    "settings.rowHoverBackground": "#f6f8fa",

    "debugToolBar.background": "#f6f8fa",
    "debugIcon.breakpointForeground": "#e01a76",
    "debugIcon.startForeground": "#1a7f37",
    "debugIcon.stopForeground": "#cf222e",

    "testing.iconPassed": "#1a7f37",
    "testing.iconFailed": "#cf222e",
    "testing.iconErrored": "#e01a76",
    "testing.iconSkipped": "#9a6700",

    "welcomePage.tileBackground": "#f6f8fa",
    "welcomePage.tileHoverBackground": "#eaeef2",
    "welcomePage.progress.foreground": "#0969da"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "#8c959f", "fontStyle": "italic" }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted", "string.template", "constant.other.symbol"],
      "settings": { "foreground": "#0a3069" }
    },
    {
      "name": "String escape / regex",
      "scope": ["constant.character.escape", "string.regexp"],
      "settings": { "foreground": "#0550ae" }
    },
    {
      "name": "Number / constant",
      "scope": ["constant.numeric", "constant.language", "keyword.other.unit", "support.constant"],
      "settings": { "foreground": "#0550ae" }
    },
    {
      "name": "Keyword / storage",
      "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier", "keyword.operator.new"],
      "settings": { "foreground": "#e01a76" }
    },
    {
      "name": "Operator / punctuation",
      "scope": ["keyword.operator", "punctuation", "meta.brace"],
      "settings": { "foreground": "#57606a" }
    },
    {
      "name": "Function",
      "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"],
      "settings": { "foreground": "#0969da" }
    },
    {
      "name": "Type / class",
      "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "support.type", "support.class"],
      "settings": { "foreground": "#953800" }
    },
    {
      "name": "Variable",
      "scope": ["variable", "meta.definition.variable", "variable.other.readwrite"],
      "settings": { "foreground": "#1f2328" }
    },
    {
      "name": "Parameter / property",
      "scope": ["variable.parameter", "variable.other.property", "variable.other.object.property", "support.type.property-name", "meta.object-literal.key", "entity.other.attribute-name"],
      "settings": { "foreground": "#cf222e" }
    },
    {
      "name": "Constant / language variable",
      "scope": ["variable.language", "variable.other.constant"],
      "settings": { "foreground": "#0550ae" }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#0969da" }
    },
    {
      "name": "Markup heading",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#0969da", "fontStyle": "bold" }
    },
    {
      "name": "Markup bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#cf222e", "fontStyle": "bold" }
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#cf222e", "fontStyle": "italic" }
    },
    {
      "name": "Markup inserted",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#1a7f37" }
    },
    {
      "name": "Markup deleted",
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#cf222e" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#cf222e" }
    },
    {
      "name": "JSON key",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#0969da" }
    }
  ],
  "semanticTokenColors": {
    "parameter": "#cf222e",
    "property": "#cf222e",
    "variable.readonly": "#0550ae",
    "function": "#0969da",
    "method": "#0969da",
    "class": "#953800",
    "interface": "#953800",
    "type": "#953800",
    "namespace": "#953800"
  }
}
