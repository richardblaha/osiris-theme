    "inputOption.activeBackground": "#0969da33",
    "inputOption.activeBorder": "#0969da",
    "inputValidation.errorBackground": "#ffebe9",
    "inputValidation.errorBorder": "#cf222e",
    "inputValidation.warningBackground": "#fff8c5",
    "inputValidation.warningBorder": "#9a6700",
    "inputValidation.infoBackground": "#ddf4ff",
    "inputValidation.infoBorder": "#0969da",

    "badge.background": "#e01a76",
    "badge.foreground": "#ffffff",
    "progressBar.background": "#e01a76",

    "scrollbar.shadow": "#1f23281a",
    "scrollbarSlider.background": "#d0d7de99",
    "scrollbarSlider.hoverBackground": "#d0d7decc",
    "scrollbarSlider.activeBackground": "#8c959fcc",
    "minimap.background": "#f6f8fa",
    "minimap.selectionHighlight": "#0969da",
    "minimap.findMatchHighlight": "#0550ae",

