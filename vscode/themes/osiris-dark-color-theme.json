  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "#565f6d", "fontStyle": "italic" }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted", "string.template", "constant.other.symbol", "constant.other.key"],
      "settings": { "foreground": "#a5d6ff" }
    },
    {
      "name": "String escape / regex",
      "scope": ["constant.character.escape", "string.regexp", "punctuation.definition.string"],
      "settings": { "foreground": "#79c0ff" }
    },
    {
      "name": "Number / constant",
      "scope": ["constant.numeric", "constant.language", "keyword.other.unit", "support.constant"],
      "settings": { "foreground": "#d29922" }
    },
    {
      "name": "Keyword / storage",
      "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier", "keyword.operator.new", "keyword.operator.expression", "modifier"],
      "settings": { "foreground": "#ff2a85" }
    },
    {
      "name": "Operator / punctuation",
      "scope": ["keyword.operator", "punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator"],
      "settings": { "foreground": "#8b949e" }
    },
    {
      "name": "Function",
      "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function", "meta.function-call", "variable.function"],
      "settings": { "foreground": "#00f2fe" }
    },
    {
      "name": "Type / class",
      "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "entity.other.inherited-class", "support.type", "support.class", "meta.type.annotation"],
      "settings": { "foreground": "#79c0ff" }
    },
    {
      "name": "Variable",
      "scope": ["variable", "meta.definition.variable", "variable.other.readwrite"],
      "settings": { "foreground": "#e6edf3" }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter", "meta.parameter"],
      "settings": { "foreground": "#ffa198" }
    },
    {
      "name": "Property / attribute",
      "scope": ["variable.other.property", "variable.other.object.property", "support.type.property-name", "meta.object-literal.key", "entity.other.attribute-name"],
      "settings": { "foreground": "#ffa198" }
    },
    {
      "name": "Constant / language variable",
      "scope": ["variable.language", "variable.other.constant", "constant.other"],
      "settings": { "foreground": "#d29922" }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#00f2fe" }
    },
    {
      "name": "Markup heading",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#00f2fe", "fontStyle": "bold" }
    },
    {
      "name": "Markup bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#ffa198", "fontStyle": "bold" }
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#ffa198", "fontStyle": "italic" }
    },
    {
      "name": "Markup link",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#a5d6ff" }
    },
    {
      "name": "Markup inserted",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#3fb950" }
    },
    {
      "name": "Markup deleted",
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#ff5555" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ff5555" }
    },
    {
      "name": "JSON key",
      "scope": ["support.type.property-name.json", "meta.structure.dictionary.json support.type.property-name.json"],
      "settings": { "foreground": "#00f2fe" }
    }
  ],
  "semanticTokenColors": {
    "parameter": "#ffa198",
    "property": "#ffa198",
    "variable.readonly": "#d29922",
    "function": "#00f2fe",
    "method": "#00f2fe",
    "class": "#79c0ff",
    "interface": "#79c0ff",
    "enum": "#79c0ff",
    "type": "#79c0ff",
    "namespace": "#79c0ff",
    "*.declaration": { "fontStyle": "bold" }
  }
}
