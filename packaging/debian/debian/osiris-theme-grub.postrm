#!/bin/sh
set -e

case "$1" in
  remove|purge)
    GRUB_DIR="/boot/grub"
    [ -d /boot/grub2 ] && GRUB_DIR="/boot/grub2"
    rm -rf "$GRUB_DIR/themes/osiris"

    if [ -f /etc/default/grub ]; then
      sed -i '\#^GRUB_THEME=.*themes/osiris#d' /etc/default/grub || true
    fi
    if command -v update-grub >/dev/null 2>&1; then
      update-grub || true
    elif command -v grub2-mkconfig >/dev/null 2>&1; then
      grub2-mkconfig -o "$GRUB_DIR/grub.cfg" || true
    fi
    ;;
esac

#DEBHELPER#
exit 0
