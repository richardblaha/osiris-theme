[Desktop Entry]
Type=X-GNOME-Metatheme
Name=@THEME_NAME@
Comment=OSIRIS dual-accent desktop theme (@VARIANT@) — cyan/rose on a GitHub-flavoured neutral ramp
Encoding=UTF-8

[X-GNOME-Metatheme]
