[%General]
author=OSIRIS
comment=OSIRIS dual-accent light Qt/Kvantum theme
x11drag=all
alt_mnemonic=true
left_tabs=true
attach_active_tab=false
mirror_doc_tabs=true
spread_progressbar=true
composite=true
menu_shadow_depth=7
tooltip_shadow_depth=6
splitter_width=1
scroll_width=8
scroll_arrows=false
transient_scrollbar=true
slider_width=4
slider_handle_width=16
slider_handle_length=16
check_size=15
progressbar_thickness=6
toolbutton_style=1
translucent_windows=false
combo_as_lineedit=true
animate_states=true
combo_menu=true
hide_combo_checkboxes=true
groupbox_top_label=true
inline_spin_indicators=true
small_icon_size=16
large_icon_size=32
respect_DE=true

[GeneralColors]
window.color=#f6f8fa
base.color=#ffffff
alt.base.color=#f6f8fa
button.color=#ffffff
light.color=#ffffff
mid.light.color=#f0f2f5
dark.color=#8c959f
mid.color=#d0d7de
highlight.color=#0969da
inactive.highlight.color=#b6d4f2
text.color=#1f2328
window.text.color=#1f2328
button.text.color=#1f2328
disabled.text.color=#8c959f
tooltip.text.color=#1f2328
highlight.text.color=#ffffff
link.color=#0969da
link.visited.color=#e01a76
progress.indicator.text.color=#ffffff

[Hacks]
transparent_menutitle=true
respect_darkness=false
kcapacitybar_as_progressbar=true
force_size_grip=true
disabled_icon_opacity=45
normal_default_pushbutton=true
single_top_toolbar=true
transparent_pcmanfm_sidebar=true

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
interior=true
interior.element=button
text.normal.color=#1f2328
text.press.color=#ffffff
text.toggle.color=#ffffff

[PanelButtonCommand:pressed]
interior.element=button-pressed
text.normal.color=#ffffff

[PanelButtonCommand:toggled]
interior.element=button-toggled
text.normal.color=#ffffff

[LineEdit]
frame=true
frame.element=lineedit
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
interior=true
interior.element=lineedit

[LineEdit:focused]
frame.element=lineedit-focused
interior.element=lineedit-focused

[IndicatorSpinBox]
inherits=LineEdit
indicator.element=spin

[Slider]
inherits=PanelButtonCommand
handle.element=slider-handle
groove=true
groove.element=slider-groove

[ProgressBar]
inherits=LineEdit
text.normal.color=#ffffff
progressbar.thickness=6

[ProgressBarContents]
interior.element=progressbar
frame=false

[MenuItem]
inherits=PanelButtonCommand
frame.element=menuitem
interior.element=menuitem
text.normal.color=#1f2328

[MenuItem:selected]
frame.element=menuitem-selected
interior.element=menuitem-selected

[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6

[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab
text.normal.color=#57606a

[Tab:selected]
frame.element=tab-selected
interior.element=tab-selected
text.normal.color=#1f2328

[Selection]
interior=true
interior.element=focus
frame=false
text.normal.color=#ffffff

[GroupBox]
frame=true
frame.element=group
interior=false

[ToolTip]
frame=true
frame.element=tooltip
interior=true
interior.element=tooltip

[Window]
interior=true
interior.element=window
