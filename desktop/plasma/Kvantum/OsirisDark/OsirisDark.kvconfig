[%General]
author=OSIRIS
comment=OSIRIS dual-accent dark Qt/Kvantum theme
x11drag=all
alt_mnemonic=true
left_tabs=true
attach_active_tab=false
mirror_doc_tabs=true
group_toolbar_buttons=false
spread_progressbar=true
composite=true
menu_shadow_depth=7
tooltip_shadow_depth=6
splitter_width=1
scroll_width=8
scroll_arrows=false
scrollbar_in_view=true
transient_scrollbar=true
transient_groove=true
slider_width=4
slider_handle_width=16
slider_handle_length=16
tickless_slider_handle_size=16
center_toolbar_handle=true
check_size=15
textless_progressbar=false
progressbar_thickness=6
menubar_mouse_tracking=true
toolbutton_style=1
click_behavior=0
translucent_windows=false
blurring=false
popup_blurring=false
vertical_spin_indicators=false
spin_button_width=20
fill_rubberband=false
merge_menubar_with_toolbar=true
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=16
combo_as_lineedit=true
animate_states=true
combo_menu=true
hide_combo_checkboxes=true
combo_focus_rect=false
groupbox_top_label=true
inline_spin_indicators=true
drag_from_buttons=false
reduce_menu_opacity=0
respect_DE=true

[GeneralColors]
window.color=#161b22
base.color=#0d1117
alt.base.color=#161b22
button.color=#21262d
light.color=#30363d
mid.light.color=#2a2f37
dark.color=#010409
mid.color=#30363d
highlight.color=#00f2fe
inactive.highlight.color=#0a3d44
text.color=#e6edf3
window.text.color=#e6edf3
button.text.color=#e6edf3
disabled.text.color=#565f6d
tooltip.text.color=#e6edf3
highlight.text.color=#04151a
link.color=#00f2fe
link.visited.color=#ff2a85
progress.indicator.text.color=#04151a

[Hacks]
transparent_dolphin_view=false
blur_translucent=false
transparent_ktitle_label=false
transparent_menutitle=true
respect_darkness=true
kcapacitybar_as_progressbar=true
force_size_grip=true
iconless_pushbutton=false
iconless_menu=false
disabled_icon_opacity=45
lxqtmainmenu_iconsize=16
normal_default_pushbutton=true
single_top_toolbar=true
tint_on_mouseover=0
transparent_pcmanfm_sidebar=true
transparent_pcmanfm_view=false
blur_only_active_window=false

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
interior=true
interior.element=button
indicator.size=8
text.normal.color=#e6edf3
text.focus.color=#e6edf3
text.press.color=#04151a
text.toggle.color=#04151a
text.shadow=0

[PanelButtonCommand:pressed]
interior.element=button-pressed
text.normal.color=#04151a

[PanelButtonCommand:toggled]
interior.element=button-toggled
text.normal.color=#04151a

[PanelButtonCommand:default]
interior.element=button-default
frame.element=button-default

[LineEdit]
frame=true
frame.element=lineedit
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
interior=true
interior.element=lineedit

[LineEdit:focused]
frame.element=lineedit-focused
interior.element=lineedit-focused

[IndicatorSpinBox]
inherits=LineEdit
indicator.element=spin
indicator.size=10

[Slider]
inherits=PanelButtonCommand
handle.element=slider-handle
groove=true
groove.element=slider-groove

[Slider:focused]
handle.element=slider-handle-focused

[ProgressBar]
inherits=LineEdit
text.normal.color=#04151a
progress.element=progress
progressbar.thickness=6

[ProgressBarContents]
interior.element=progressbar
frame=false

[MenuItem]
inherits=PanelButtonCommand
frame=true
frame.element=menuitem
interior.element=menuitem
text.normal.color=#e6edf3
text.focus.color=#e6edf3

[MenuItem:selected]
frame.element=menuitem-selected
interior.element=menuitem-selected

[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6

[TabWidgetFrame]
frame=true
frame.element=tab
interior=true

[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab
text.normal.color=#8b949e
text.focus.color=#e6edf3

[Tab:selected]
frame.element=tab-selected
interior.element=tab-selected
text.normal.color=#e6edf3

[TreeExpander]
inherits=PanelButtonCommand
indicator.size=9

[Selection]
interior=true
interior.element=focus
frame=false
text.normal.color=#04151a
text.focus.color=#04151a

[GroupBox]
frame=true
frame.element=group
interior=false
text.normal.color=#e6edf3

[ToolTip]
frame=true
frame.element=tooltip
interior=true
interior.element=tooltip
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4

[Window]
interior=true
interior.element=window
